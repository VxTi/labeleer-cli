{
  "name": "labeleer-cli",
  "version": "2.0.0",
  "type": "module",
  "description": "A CLI tool to synchronize translation labels with Labeleer.",
  "author": "Luca Warmenhoven",
  "license": "ISC",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/VxTi/labeleer-cli.git"
  },
  "scripts": {
    "start": "tsx ./src/index.ts",
    "check:types": "tsc --noEmit",
    "build": "esbuild ./src/index.ts --bundle --packages=external --minify --platform=node --format=esm --outfile=./dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"./src/**/*.ts\" --fix --max-warnings 0 --cache",
    "create:schema": "tsx ./bin/create-project-config-json-schema.ts"
  },
  "bin": {
    "labeleer-cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@labeleer/api": "1.0.3",
    "@labeleer/translation-dataset-transformers": "^2.2.7",
    "@inquirer/prompts": "^8.7.3",
    "lodash-es": "^4.18.1",
    "chalk": "^6.0.1",
    "ora": "^9.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
